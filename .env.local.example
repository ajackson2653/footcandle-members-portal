NEXT_PUBLIC_SUPABASE_URL=https://rcjvdvyaqfpbqjunmqjf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_DUPpA49gmzLkJzv4bGNv6A_adAwJXFl
NEXT_PUBLIC_SITE_URL=https://members.footcandle.org

# Comma-separated list of admin emails allowed into /admin. If left blank,
# admin stays open to any logged-in user (setup grace). Set before members log in.
NEXT_PUBLIC_ADMIN_EMAILS=alan@footcandle.org

# Server-only: used by /api/members for admin writes (never exposed to the browser).
# Get it from Supabase → Project Settings → API → service_role secret.
# Set the same value in Vercel → Settings → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: Brevo transactional email (email-queue "Send"). From Brevo →
# SMTP & API → API Keys. Sender email must be a verified sender/domain in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@footcandle.org
BREVO_SENDER_NAME=Footcandle Film Society

# Server-only: protects the scheduled cron routes (digest, renewal reminders).
# Set any long random string; Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Stripe (membership payments on /renew). From the Stripe dashboard.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you create pointing at
# https://<site>/api/stripe/webhook (events: checkout.session.completed, invoice.paid).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: dedicated secret for signing /renew?t= links (falls back to CRON_SECRET).
RENEW_LINK_SECRET=
